{
  "name": "streamguard",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "A local-first ad shield for Twitch live streams.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spaced1127/StreamGuard.git"
  },
  "homepage": "https://github.com/Spaced1127/StreamGuard#readme",
  "bugs": {
    "url": "https://github.com/Spaced1127/StreamGuard/issues"
  },
  "keywords": [
    "twitch",
    "adblock",
    "browser-extension",
    "chrome-extension",
    "firefox-extension",
    "brave",
    "manifest-v3",
    "hls",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs --target=chrome",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
